# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# uv / virtualenv. uv.lock is committed on purpose -- CONTRIBUTING.md documents
# `uv sync --frozen`, which is only reproducible if the lockfile is in the tree.
.venv/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Secrets and local configuration. There is no .env in this repository and there
# never will be one -- see SECURITY.md.
.env
.env.*
!.env.example

# Exchange credential material. The directory itself is tracked (via .gitkeep)
# so that a clean clone owns it before Docker does; everything inside it is not.
/secrets/*
!/secrets/.gitkeep

# Backups. Written by `make backup` to a different physical device in practice;
# ignored here so a local run cannot commit a database dump.
/backups/

# Local market archives. Anchored to the repository root on purpose: an unanchored
# `data/` also matches src/fking/data/, which silently drops a source package from
# every commit.
/data/
*.parquet

# Rendered by `make audit` and by CI from uv.lock. Never committed: a checked-in
# requirements file becomes a second, silently divergent source of dependency truth
# the moment someone edits it instead of the lockfile.
/audited-requirements.txt
/merged-compose.yml

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Agent worktrees and scratch output. Sessions that orchestrate subagents create a
# git worktree per agent under .claude/worktrees/ and leave gate transcripts behind.
# These are per-session artefacts of *how* the work was produced, not the work: a
# committed `make check` log is a stale claim about a tree that has since moved on,
# and CLAUDE.md 7 requires the evidence be re-run rather than read from a file.
/.claude/worktrees/
/check_baseline.log
/check.log
/*.tmp.json
