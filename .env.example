FKING_BACKTEST__RUN_SEED=
FKING_BACKTEST__WARMUP_BARS=

# --------------------------------------------------------------------------
# RISK -- Limits, each bounded by a compiled-in constant in the direction that
# makes it riskier: MAX_* from above, MIN_* and CONVICTION_FLOOR from below.
# Tightening is free. A value past its bound aborts startup rather than
# clamping silently, because a clamped limit is a limit nobody chose.
# --------------------------------------------------------------------------
FKING_RISK__CONVICTION_FLOOR=
FKING_RISK__KILL_SWITCH_DAILY_LOSS_RATIO=
FKING_RISK__KILL_SWITCH_ENABLED=
FKING_RISK__MAX_CORRELATED_EXPOSURE_RATIO=
FKING_RISK__MAX_DAILY_DRAWDOWN_RATIO=
FKING_RISK__MAX_LEVERAGE=
FKING_RISK__MAX_OPEN_POSITIONS=
FKING_RISK__MAX_ORDERS_PER_MINUTE=
FKING_RISK__MAX_PORTFOLIO_NOTIONAL_USD=
FKING_RISK__MAX_POSITION_NOTIONAL_USD=
FKING_RISK__MAX_SINGLE_ORDER_NOTIONAL_USD=
FKING_RISK__MAX_TOTAL_DRAWDOWN_RATIO=
FKING_RISK__MIN_FREE_MARGIN_RATIO=
FKING_RISK__MIN_TRADES_FOR_KELLY=
FKING_RISK__REQUIRE_INVALIDATION_LEVEL=

# --------------------------------------------------------------------------
# AGENTS -- LLM providers and budgets.
# Disabled by default: the system must be fully functional with every agent off,
# because that is the degraded mode, and a degraded mode that has never been the
# default is a degraded mode that does not work.
# --------------------------------------------------------------------------
FKING_AGENTS__BUDGETS=
FKING_AGENTS__DEGRADE_TO_DETERMINISTIC_ON_QUOTA_EXHAUSTION=
FKING_AGENTS__ENABLED=
FKING_AGENTS__FALLBACK__API_KEY=
FKING_AGENTS__FALLBACK__BASE_URL=
FKING_AGENTS__FALLBACK__DAILY_TOKEN_BUDGET=
FKING_AGENTS__FALLBACK__MODEL=
FKING_AGENTS__FALLBACK__REQUESTS_PER_MINUTE=
FKING_AGENTS__FALLBACK__TIMEOUT_SECONDS=
FKING_AGENTS__MAX_REASK_ATTEMPTS=
FKING_AGENTS__PRIMARY__API_KEY=
FKING_AGENTS__PRIMARY__BASE_URL=
FKING_AGENTS__PRIMARY__DAILY_TOKEN_BUDGET=
FKING_AGENTS__PRIMARY__MODEL=
FKING_AGENTS__PRIMARY__REQUESTS_PER_MINUTE=
FKING_AGENTS__PRIMARY__TIMEOUT_SECONDS=
FKING_AGENTS__PROMPT_ROOT=
FKING_AGENTS__REQUIRE_PROMPT_HASH_MATCH=

