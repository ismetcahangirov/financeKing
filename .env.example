# --------------------------------------------------------------------------
# DATABASE -- Postgres/TimescaleDB connection and roles.
# --------------------------------------------------------------------------
# Three DSNs, one per privilege class. They must connect as three different
# roles -- configuration validation refuses a shared one, because a single
# over-privileged connection serves every query correctly and the separation
# disappears with no error anywhere.
FKING_DATABASE__APPLICATION_ROLE=
FKING_DATABASE__DSN=
FKING_DATABASE__INGEST_DSN=
FKING_DATABASE__INGEST_ROLE=
FKING_DATABASE__MIGRATION_ROLE=
FKING_DATABASE__MIGRATOR_DSN=
FKING_DATABASE__POOL_MAX_SIZE=
FKING_DATABASE__POOL_MIN_SIZE=
FKING_DATABASE__STATEMENT_TIMEOUT_SECONDS=

# --------------------------------------------------------------------------
# BUS -- Redis Streams event bus.
# --------------------------------------------------------------------------
FKING_BUS__CLAIM_IDLE_MS=
FKING_BUS__CONSUMER_GROUP_PREFIX=
FKING_BUS__DLQ_STREAM_SUFFIX=
FKING_BUS__MAX_STREAM_LENGTH=
FKING_BUS__REDIS_URL=
FKING_BUS__REQUIRE_CORRELATION_ID=

# --------------------------------------------------------------------------
# API -- FastAPI surface. HOST is fixed at 127.0.0.1 and cannot be widened.
# --------------------------------------------------------------------------
FKING_API__CORS_ORIGINS=
FKING_API__HOST=
FKING_API__PORT=

# --------------------------------------------------------------------------
# SCHEDULER -- the in-process beat (ADR-0019). TIMEZONE is fixed at UTC, and
# missed-run behaviour is declared per job rather than configured here.
# --------------------------------------------------------------------------
FKING_SCHEDULER__MAX_CONCURRENT_JOBS=
FKING_SCHEDULER__TICK_INTERVAL_SECONDS=
FKING_SCHEDULER__TIMEZONE=

