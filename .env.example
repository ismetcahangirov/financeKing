# financeKing configuration template.
#
# Copy to `.env` and set only what you need. Every value here is deliberately BLANK: a
# placeholder that looks like a credential is a credential somebody pastes over with a
# real one and then commits, and SECURITY.md section 2 vector 2 is exactly that person.
#
# Precedence, highest first: environment variables, then this file, then the code
# defaults on the model. An empty value binds as an empty string and will usually fail
# validation -- delete or comment out the lines you do not set rather than leaving them
# blank in your own `.env`.
#
# The code defaults are the safe baseline. With no `.env` at all the process starts with
# the tightest limits, testnet venues, agents disabled and one symbol, so nothing here
# needs a value for the system to run.
#
# Checked against the settings tree by tests/platform/config/test_env_example.py in both
# directions: a new setting with no entry here fails, and an entry for a setting that no
# longer exists fails. Regenerate rather than hand-edit when the tree changes.
#
# `.env` is gitignored and must stay that way. Secrets are never inlined into
# docker-compose.yml, and `.env` is never mounted into the observability containers --
# Grafana, Prometheus, Loki and Tempo have no reason to see exchange credentials.

# --------------------------------------------------------------------------
# DATA -- Ingestion, storage and the feature store.
# ARCHIVE_BASE_URL is a public data host, not a venue: it is deliberately absent
# from the trading allowlist and is not validated against it at boot.
# --------------------------------------------------------------------------
FKING_DATA__ARCHIVE_BASE_URL=
FKING_DATA__ARCHIVE_CACHE_ROOT=
FKING_DATA__ARCHIVE_DOWNLOAD_CONCURRENCY=
FKING_DATA__ARCHIVE_RETRY_ATTEMPTS=
FKING_DATA__BACKFILL_FROM_REST=
FKING_DATA__BAR_INTERVALS=
FKING_DATA__BAR_PARTITION_GRANULARITY=
FKING_DATA__FEATURE_CACHE_SIZE_MB=
FKING_DATA__HISTORY_START=
FKING_DATA__HYPERTABLE_CHUNK_INTERVAL=
FKING_DATA__KLINE_CADENCE_GRACE_SECONDS=
FKING_DATA__MAX_OHLC_INCOHERENCE_RATIO=
FKING_DATA__MAX_ROW_REJECTION_RATIO=
FKING_DATA__OPERATIONAL_BAR_WINDOW=
FKING_DATA__PARQUET_COMPRESSION=
FKING_DATA__PARQUET_COMPRESSION_LEVEL=
FKING_DATA__PARQUET_ROOT=
FKING_DATA__PARQUET_TARGET_FILE_MB=
FKING_DATA__REFUSE_UNDECLARED_FEATURES=
FKING_DATA__STALENESS_THRESHOLD_SECONDS=
FKING_DATA__TRADE_PARTITION_GRANULARITY=
FKING_DATA__UNIVERSE=
FKING_DATA__VERIFY_CHECKSUMS=
FKING_DATA__WS_RECONNECT_BASE_SECONDS=
FKING_DATA__WS_RECONNECT_CAP_SECONDS=

# --------------------------------------------------------------------------
# EXCHANGE -- Venues and credentials.
# ENABLED is false by default so a fresh clone boots. Switching it on makes the
# futures credentials mandatory at startup, named field by field.
# SPOT_ED25519_KEY_PATH is a FILE PATH, never key material: environment variables
# are inherited by child processes, appear in `docker inspect` and in
# /proc/<pid>/environ. A file has permissions, and a mode wider than 0600 aborts
# the boot on POSIX.
# --------------------------------------------------------------------------
FKING_EXCHANGE__BINANCE__FUTURES_API_KEY=
FKING_EXCHANGE__BINANCE__FUTURES_API_SECRET=
FKING_EXCHANGE__BINANCE__FUTURES_REST_URL=
FKING_EXCHANGE__BINANCE__FUTURES_WS_URL=
FKING_EXCHANGE__BINANCE__RATE_LIMIT_HEADROOM_RATIO=
FKING_EXCHANGE__BINANCE__RECV_WINDOW_MS=
FKING_EXCHANGE__BINANCE__REQUEST_TIMEOUT_SECONDS=
FKING_EXCHANGE__BINANCE__SPOT_API_KEY=
FKING_EXCHANGE__BINANCE__SPOT_ED25519_KEY_PATH=
FKING_EXCHANGE__BINANCE__SPOT_REST_URL=
FKING_EXCHANGE__BINANCE__SPOT_WS_URL=
FKING_EXCHANGE__BYBIT__API_KEY=
FKING_EXCHANGE__BYBIT__API_SECRET=
FKING_EXCHANGE__BYBIT__REQUEST_TIMEOUT_SECONDS=
FKING_EXCHANGE__BYBIT__REST_URL=
FKING_EXCHANGE__BYBIT__WS_URL=
FKING_EXCHANGE__ENABLED=
FKING_EXCHANGE__EXECUTION__CLIENT_ORDER_ID_PREFIX=
FKING_EXCHANGE__EXECUTION__DEFAULT_URGENCY=
FKING_EXCHANGE__EXECUTION__MAX_ORDER_DURATION_SECONDS=
FKING_EXCHANGE__EXECUTION__MAX_RECONCILIATION_AGE_SECONDS=
FKING_EXCHANGE__EXECUTION__RECONCILE_INTERVAL_SECONDS=
FKING_EXCHANGE__EXECUTION__RECONCILE_ON_STARTUP=
FKING_EXCHANGE__EXECUTION__RETRY_AFTER_AMBIGUOUS_RESPONSE=
FKING_EXCHANGE__FEES__BNB_DISCOUNT_APPLIED=
FKING_EXCHANGE__FEES__FUTURES_MAKER_BP=
FKING_EXCHANGE__FEES__FUTURES_TAKER_BP=
FKING_EXCHANGE__FEES__SPOT_MAKER_BP=
FKING_EXCHANGE__FEES__SPOT_TAKER_BP=

# --------------------------------------------------------------------------
# BACKTEST -- Engine, credibility gates and cost model.
# COST_MODEL__CALIBRATION_SOURCE naming a testnet is refused: futures testnet
# shows a 7.5bp spread against production's 0.16bp, so a model calibrated there
# looks conservative and is fiction.
# --------------------------------------------------------------------------
FKING_BACKTEST__COST_MODEL__CALIBRATED_AT=
FKING_BACKTEST__COST_MODEL__CALIBRATION_METHOD=
FKING_BACKTEST__COST_MODEL__CALIBRATION_SOURCE=
FKING_BACKTEST__COST_MODEL__FUNDING_ENABLED=
