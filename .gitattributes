# Normalise to LF in the working tree, not just in the index.
#
# The reason is concrete: development happens on Windows while `make check` runs
# inside a Linux container against the same working copy. With the default
# core.autocrlf, a checkout rewrites the Makefile and the shell it invokes to CRLF,
# and GNU Make inside the container then reads a trailing \r as part of every command.
* text=auto eol=lf

# Generated, and large. Marking it keeps it out of diff review noise while still
# being committed -- `uv sync --frozen` is not reproducible without it.
uv.lock linguist-generated=true

# Recorded archive fixtures are byte-exact evidence, not merely test input: their SHA-256
# digests are asserted against the digests `data.binance.vision` served, in
# tests/data/test_archive_fixture_integrity.py. Any line-ending translation in either
# direction changes the bytes and breaks that assertion on the platform that did the
# translating, which reads as tampering rather than as a checkout artefact.
#
# The rule above already resolves to LF, so these two lines are redundant today. They are
# here because the digests depend on it: a future edit to the global rule must not be able
# to invalidate the corpus silently.
tests/fixtures/archives/**/*.csv text eol=lf
tests/fixtures/archives/**/*.zip binary

# Recorded WebSocket frames, for exactly the same reason: one JSON document per line,
# committed verbatim, with a SHA-256 over the file asserted in
# tests/data/test_stream_fixture_integrity.py. A checkout that rewrote the separators
# would fail that assertion on the platform that did the rewriting -- and the failure
# reads as a hand-edited fixture, which is the thing the digest exists to detect.
tests/fixtures/streams/**/*.jsonl text eol=lf

# The corrupted corpus is derived from those recordings and asserted byte for byte against
# a re-run of its generator. It needs the same protection and needs it more: the members
# are STORED rather than deflated, so a corrupt .zip is mostly ASCII CSV and git's text
# heuristic classifies it as text. Any end-of-line translation then rewrites the archive,
# and the re-derivation fails on the platform that did the translating.
tests/fixtures/corrupt/**/*.zip binary
